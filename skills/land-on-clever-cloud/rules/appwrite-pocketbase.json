    {
      "dep": "node-appwrite",
      "strength": "strong"
    },
    {
      "dep": "pocketbase",
      "strength": "strong"
    },
    {
      "path": "(^|/)pb_(hooks|migrations)/",
      "strength": "strong",
      "signal": "PocketBase hooks/migrations"
    },
    {
      "code": "POCKETBASE_URL",
      "strength": "weak",
      "signal": "POCKETBASE_URL"
    }
  ],
  "min_weak": 2,
  "not_covered_note": "Keep the BaaS (landing A) or replace the backend. PocketBase = SQLite on disk → FS Bucket, single instance, never in HDS.",
  "traps": []
